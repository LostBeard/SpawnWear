@page "/"
@using SpawnDev.BlazorJS.Cryptography
@using SpawnWear.Bridge
@using SpawnWear.Bridge.Pairing
@using SpawnWear.Bridge.WebRtc
@inject BridgeClient Bridge
@inject IPortableCrypto Crypto
@inject IPairingStore PairingStore
@inject WebRtcTransportFactory WebRtcFactory
@implements IDisposable

<PageTitle>SpawnWear Companion</PageTitle>

<div class="hero">
    <h1>SpawnWear Companion</h1>
    <p class="tagline">Pair, mirror, and control your SpawnWear watch from the browser.</p>
</div>

<div class="card">
    <div class="card-row">
        <span class="badge @(Bridge.IsConnected ? "ok" : "off")">
            @(Bridge.IsConnected ? "CONNECTED" : "DISCONNECTED")
        </span>
        @if (!Bridge.IsConnected)
        {
            <button class="primary" @onclick="ConnectAsync">Pair over BLE</button>
        }
        else
        {
            <button class="secondary" @onclick="DisconnectAsync">Disconnect</button>
        }
    </div>

    @if (Bridge.IsConnected)
    {
        <div class="card-row" style="margin-top:0.6rem;">
            <span class="badge @(_record is null ? "off" : "ok")">
                @(_record is null ? "NOT TRUSTED" : "TRUSTED")
            </span>
            @if (_record is null)
            {
                <button class="primary" @onclick="DoPairAsync" disabled="@_pairing">
                    @(_pairing ? "Pairing…" : "Establish trust (Phase 7)")
                </button>
            }
            else
            {
                <button class="ghost" @onclick="ForgetTrust">Forget trust</button>
            }
        </div>
        @if (_record is { } r)
        {
            <div class="muted" style="margin-top:0.4rem; font-size:0.78rem; font-family: ui-monospace, 'SF Mono', monospace;">
                Watch pubkey: @ShortHex(r.WatchPubKey) · Room: @ShortHex(r.RoomKey) · Paired @r.PairedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </div>
        }
    }

    @if (_lastError is not null)
    {
        <div class="error">@_lastError</div>
    }
</div>

@if (!Bridge.IsConnected && _savedPairings.Count > 0)
{
    <div class="card">
        <div class="stat-label" style="margin-bottom:0.4rem;">PAIRED WATCHES</div>
        <p class="muted" style="font-size:0.85rem;">Connect over WebRTC through hub.spawndev.com — no BLE permission prompt, no shared network required.</p>
        @foreach (var p in _savedPairings)
        {
            <div class="paired-row">
                <div class="paired-meta">
                    <div class="paired-name">@(p.FriendlyName ?? "(unnamed)")</div>
                    <div class="paired-sub">key @ShortHex(p.WatchPubKey) · paired @p.PairedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
                </div>
                <button class="primary" @onclick="() => ConnectViaWebRtcAsync(p)" disabled="@_promotingToWebRtc">
                    @(_promotingToWebRtc ? "Connecting…" : "Connect (WebRTC)")
                </button>
                <button class="ghost" @onclick="() => ForgetPairing(p)">Forget</button>
            </div>
        }
    </div>
}

<div class="cards">
    <div class="card stat">
        <div class="stat-label">Battery</div>
        <div class="stat-value">@(_battery?.Percent.ToString() ?? "-")<span class="unit">%</span></div>
        <div class="stat-sub">@(_battery is null ? "no data" : (_battery.Value.IsCharging ? "charging" : (_battery.Value.IsVbusPresent ? "USB" : "on battery")))</div>
    </div>

    <div class="card stat">
        <div class="stat-label">IMU</div>
        <div class="stat-value tiny">@FormatImu()</div>
        <div class="stat-sub">accel + gyro raw</div>
    </div>

    <div class="card stat">
        <div class="stat-label">Last button</div>
        <div class="stat-value tiny">@FormatButton()</div>
        <div class="stat-sub">BOOT / PWR events</div>
    </div>

    <div class="card stat">
        <div class="stat-label">Last log</div>
        <div class="stat-value tiny">@(_lastLog ?? "-")</div>
        <div class="stat-sub">debug stream</div>
    </div>
</div>

<style>
    .hero { padding: 2rem 0 1rem; text-align: center; }
    .hero h1 { font-size: 2.4rem; margin: 0; background: linear-gradient(120deg,#5b8def,#9d6bff); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .tagline { opacity: 0.7; margin: 0.4rem 0 0; }
    .card { background: var(--card-bg, #1f2330); border: 1px solid #2c2f3a; border-radius: 14px; padding: 1.2rem 1.4rem; margin: 0.8rem 0; }
    .card-row { display: flex; align-items: center; gap: 1rem; }
    .badge { padding: 0.2rem 0.7rem; border-radius: 999px; font-size: 0.75rem; letter-spacing: 0.06em; font-weight: 600; }
    .badge.ok { background: rgba(70,210,140,0.15); color: #6dd9a4; }
    .badge.off { background: rgba(220,80,90,0.15); color: #ec7986; }
    .error { color: #ec7986; margin-top: 0.6rem; font-size: 0.9rem; }
    button.primary { margin-left: auto; background: linear-gradient(120deg,#5b8def,#9d6bff); color: white; border: 0; padding: 0.55rem 1.1rem; border-radius: 999px; font-weight: 600; cursor: pointer; }
    button.secondary { margin-left: auto; background: #2c2f3a; color: #d8dae4; border: 0; padding: 0.55rem 1.1rem; border-radius: 999px; font-weight: 500; cursor: pointer; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 0.8rem; }
    .stat { text-align: left; }
    .stat-label { opacity: 0.6; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .stat-value { font-size: 1.9rem; font-weight: 700; line-height: 1.1; margin: 0.2rem 0; }
    .stat-value.tiny { font-size: 0.85rem; font-weight: 500; font-family: ui-monospace, "SF Mono", monospace; word-break: break-all; }
    .stat-sub { opacity: 0.55; font-size: 0.78rem; }
    .unit { font-size: 1rem; opacity: 0.5; margin-left: 0.15rem; }
    .paired-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0; border-top: 1px solid #2c2f3a; }
    .paired-row:first-of-type { border-top: 0; }
    .paired-meta { flex: 1; }
    .paired-name { font-weight: 600; font-size: 0.95rem; }
    .paired-sub { opacity: 0.55; font-family: ui-monospace, "SF Mono", monospace; font-size: 0.75rem; }
</style>

@code {
    BatteryState? _battery;
    ImuSample? _imu;
    ButtonEvent? _button;
    string? _lastLog;
    string? _lastError;

    PairingRecord? _record;
    bool _pairing;
    bool _promotingToWebRtc;
    List<PairingRecord> _savedPairings = new();

    protected override void OnInitialized()
    {
        Bridge.ConnectionChanged   += OnConnectionChanged;
        Bridge.BatteryChanged      += OnBattery;
        Bridge.ImuSampleReceived   += OnImu;
        Bridge.ButtonEventReceived += OnButton;
        Bridge.DebugLogReceived    += OnLog;

        _savedPairings = PairingStore.List().ToList();
    }

    public void Dispose()
    {
        Bridge.ConnectionChanged   -= OnConnectionChanged;
        Bridge.BatteryChanged      -= OnBattery;
        Bridge.ImuSampleReceived   -= OnImu;
        Bridge.ButtonEventReceived -= OnButton;
        Bridge.DebugLogReceived    -= OnLog;
    }

    void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);
    void OnBattery(BatteryState b)           { _battery = b;  InvokeAsync(StateHasChanged); }
    void OnImu(ImuSample i)                  { _imu = i;      InvokeAsync(StateHasChanged); }
    void OnButton(ButtonEvent e)             { _button = e;   InvokeAsync(StateHasChanged); }
    void OnLog(string msg)                   { _lastLog = msg;InvokeAsync(StateHasChanged); }

    string FormatButton() => _button is null
        ? "-"
        : $"{_button.Value.Button} {_button.Value.Action}";

    async Task ConnectAsync()
    {
        _lastError = null;
        try
        {
            await Bridge.ConnectAsync();
            // Pull current state immediately so the cards show real
            // values without waiting for the next firmware notify.
            await Bridge.RefreshAsync();
        }
        catch (NotImplementedException ex) { _lastError = "BLE transport not yet wired (Phase 4a). " + ex.Message; }
        catch (Exception ex) { _lastError = ex.Message; }
    }

    async Task DoPairAsync()
    {
        _lastError = null; _pairing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Bridge needs an ITransport reference; the transport is
            // wrapped inside BridgeClient. PairingFlow takes ITransport
            // directly so a future Bridge.Desktop consumer can use it
            // the same way - we expose it via a small accessor.
            var transport = Bridge.GetUnderlyingTransport()
                ?? throw new InvalidOperationException("BridgeClient has no transport configured.");
            var flow = new PairingFlow(Crypto, PairingStore);
            _record = await flow.PairAsync(transport, friendlyName: Bridge.PeerName);
        }
        catch (PairingException ex) { _lastError = "Pairing failed: " + ex.Message; }
        catch (NotSupportedException ex) { _lastError = "Watch firmware does not yet advertise the Phase 7 pairing characteristics. " + ex.Message; }
        catch (Exception ex) { _lastError = ex.Message; }
        finally
        {
            _pairing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void ForgetTrust()
    {
        if (_record is { } r) PairingStore.Remove(r.WatchPubKey);
        _record = null;
        _savedPairings = PairingStore.List().ToList();
    }

    void ForgetPairing(PairingRecord p)
    {
        PairingStore.Remove(p.WatchPubKey);
        _savedPairings = PairingStore.List().ToList();
    }

    async Task ConnectViaWebRtcAsync(PairingRecord pairing)
    {
        _lastError = null; _promotingToWebRtc = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var transport = WebRtcFactory.CreateTransport(pairing);
            await Bridge.UseTransportAsync(transport);
            await Bridge.ConnectAsync();
            _record = pairing;
        }
        catch (Exception ex) { _lastError = "WebRTC connect failed: " + ex.Message; }
        finally
        {
            _promotingToWebRtc = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    static string ShortHex(byte[] b) => Convert.ToHexString(b)[..16].ToLowerInvariant() + "…";

    async Task DisconnectAsync()
    {
        try { await Bridge.DisconnectAsync(); }
        catch (Exception ex) { _lastError = ex.Message; }
    }

    string FormatImu() => _imu is null
        ? "-"
        : $"a={_imu.Value.Ax},{_imu.Value.Ay},{_imu.Value.Az}  g={_imu.Value.Gx},{_imu.Value.Gy},{_imu.Value.Gz}";
}
