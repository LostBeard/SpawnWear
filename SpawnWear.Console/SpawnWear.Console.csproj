<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RootNamespace avoids ending in "Console" so the System.Console type isn't shadowed. -->
    <RootNamespace>SpawnWearConsole</RootNamespace>
    <AssemblyName>SpawnWear.Console</AssemblyName>
    <Authors>SpawnDev (LostBeard / TJ Tanner)</Authors>
    <Description>SpawnWear console companion - manage the watch (apps + files) over WebRTC via SpawnWear.Bridge.</Description>
    <Version>0.0.1-prealpha</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpawnWear.Bridge\SpawnWear.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desktop SipSorcery-fork WebRTC backend + cross-platform Ed25519 (same versions as Bridge.Desktop). -->
    <PackageReference Include="SpawnDev.RTC" Version="1.1.11" />
    <PackageReference Include="SpawnDev.BlazorJS.Cryptography" Version="3.2.0" />
    <!-- Verbose SipSorcery ICE/DTLS/SCTP logging (verbose flag) for connection diagnostics. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
